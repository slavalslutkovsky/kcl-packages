schema ChaosMeshOrgV1alpha1ScheduleSpecPhysicalmachineChaosNetworkPartition:
    r"""
    chaos mesh org v1alpha1 schedule spec physicalmachine chaos network partition

    Attributes
    ----------
    "accept-tcp-flags" : str, default is Undefined, optional
        only the packet which match the tcp flag can be accepted, others will be dropped.
        only set when the IPProtocol is tcp, used for partition.
    device : str, default is Undefined, optional
        the network interface to impact
    direction : str, default is Undefined, optional
        specifies the partition direction, values can be 'from', 'to'.
        'from' means packets coming from the 'IPAddress' or 'Hostname' and going to your server,
        'to' means packets originating from your server and going to the 'IPAddress' or 'Hostname'.
    hostname : str, default is Undefined, optional
        only impact traffic to these hostnames
    "ip-address" : str, default is Undefined, optional
        only impact egress traffic to these IP addresses
    "ip-protocol" : str, default is Undefined, optional
        only impact egress traffic to these IP addresses
    """


    "accept-tcp-flags"?: str

    device?: str

    direction?: str

    hostname?: str

    "ip-address"?: str

    "ip-protocol"?: str


