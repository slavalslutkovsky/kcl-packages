schema ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaos:
    r"""
    NetworkChaosSpec defines the desired state of NetworkChaos

    Attributes
    ----------
    action : str, default is Undefined, required
        Action defines the specific network chaos action.
        Supported action: partition, netem, delay, loss, duplicate, corrupt
        Default action: delay
    bandwidth : ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosBandwidth, default is Undefined, optional
        bandwidth
    corrupt : ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosCorrupt, default is Undefined, optional
        corrupt
    delay : ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosDelay, default is Undefined, optional
        delay
    device : str, default is Undefined, optional
        Device represents the network device to be affected.
    direction : str, default is "to", optional
        Direction represents the direction, this applies on netem and network partition action
    duplicate : ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosDuplicate, default is Undefined, optional
        duplicate
    duration : str, default is Undefined, optional
        Duration represents the duration of the chaos action
    externalTargets : [str], default is Undefined, optional
        ExternalTargets represents network targets outside k8s
    loss : ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosLoss, default is Undefined, optional
        loss
    mode : str, default is Undefined, required
        Mode defines the mode to run chaos action.
        Supported mode: one / all / fixed / fixed-percent / random-max-percent
    rate : ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosRate, default is Undefined, optional
        rate
    remoteCluster : str, default is Undefined, optional
        RemoteCluster represents the remote cluster where the chaos will be deployed
    selector : ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosSelector, default is Undefined, required
        selector
    target : ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosTarget, default is Undefined, optional
        target
    targetDevice : str, default is Undefined, optional
        TargetDevice represents the network device to be affected in target scope.
    value : str, default is Undefined, optional
        Value is required when the mode is set to `FixedMode` / `FixedPercentMode` / `RandomMaxPercentMode`.
        If `FixedMode`, provide an integer of pods to do chaos action.
        If `FixedPercentMode`, provide a number from 0-100 to specify the percent of pods the server can do chaos action.
        IF `RandomMaxPercentMode`,  provide a number from 0-100 to specify the max percent of pods to do chaos action
    """


    action: "netem" | "delay" | "loss" | "duplicate" | "corrupt" | "partition" | "bandwidth"

    bandwidth?: ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosBandwidth

    corrupt?: ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosCorrupt

    delay?: ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosDelay

    device?: str

    direction?: "to" | "from" | "both" = "to"

    duplicate?: ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosDuplicate

    duration?: str

    externalTargets?: [str]

    loss?: ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosLoss

    mode: "one" | "all" | "fixed" | "fixed-percent" | "random-max-percent"

    rate?: ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosRate

    remoteCluster?: str

    selector: ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosSelector

    target?: ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosTarget

    targetDevice?: str

    value?: str


schema ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosBandwidth:
    r"""
    Bandwidth represents the detail about bandwidth control action

    Attributes
    ----------
    buffer : int, default is Undefined, required
        Buffer is the maximum amount of bytes that tokens can be available for instantaneously.
    limit : int, default is Undefined, required
        Limit is the number of bytes that can be queued waiting for tokens to become available.
    minburst : int, default is Undefined, optional
        Minburst specifies the size of the peakrate bucket. For perfect
        accuracy, should be set to the MTU of the interface.  If a
        peakrate is needed, but some burstiness is acceptable, this
        size can be raised. A 3000 byte minburst allows around 3mbit/s
        of peakrate, given 1000 byte packets.
    peakrate : int, default is Undefined, optional
        Peakrate is the maximum depletion rate of the bucket.
        The peakrate does not need to be set, it is only necessary
        if perfect millisecond timescale shaping is required.
    rate : str, default is Undefined, required
        Rate is the speed knob. Allows bit, kbit, mbit, gbit, tbit, bps, kbps, mbps, gbps, tbps unit. bps means bytes per second.
    """


    buffer: int

    limit: int

    minburst?: int

    peakrate?: int

    rate: str


    check:
        buffer >= 1
        limit >= 1
        minburst >= 0 if minburst not in [None, Undefined]
        peakrate >= 0 if peakrate not in [None, Undefined]


schema ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosCorrupt:
    r"""
    Corrupt represents the detail about corrupt action

    Attributes
    ----------
    correlation : str, default is Undefined, optional
        correlation
    corrupt : str, default is Undefined, required
        corrupt
    """


    correlation?: str

    corrupt: str


schema ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosDelay:
    r"""
    Delay represents the detail about delay action

    Attributes
    ----------
    correlation : str, default is Undefined, optional
        correlation
    jitter : str, default is Undefined, optional
        jitter
    latency : str, default is Undefined, required
        latency
    reorder : ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosDelayReorder, default is Undefined, optional
        reorder
    """


    correlation?: str

    jitter?: str

    latency: str

    reorder?: ChaosMeshOrgV1alpha1ScheduleSpecNetworkChaosDelayReorder


    check:
        _regex_match(str(jitter), r"^[0-9]+(\.[0-9]+)?(ns|us|ms|s|m|h)$") if jitter
        _regex_match(str(latency), r"^[0-9]+(\.[0-9]+)?(ns|us|ms|s|m|h)$")


