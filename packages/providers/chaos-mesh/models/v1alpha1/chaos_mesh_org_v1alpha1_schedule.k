schema ChaosMeshOrgV1alpha1ScheduleSpecIoChaosMistake:
    r"""
    Mistake defines what types of incorrectness are injected to IO operations

    Attributes
    ----------
    filling : str, default is Undefined, optional
        Filling determines what is filled in the mistake data.
    maxLength : int, default is Undefined, optional
        Max length of each wrong data segment in bytes
    maxOccurrences : int, default is Undefined, optional
        There will be [1, MaxOccurrences] segments of wrong data.
    """


    filling?: "zero" | "random"

    maxLength?: int

    maxOccurrences?: int


    check:
        maxLength >= 1 if maxLength not in [None, Undefined]
        maxOccurrences >= 1 if maxOccurrences not in [None, Undefined]


schema ChaosMeshOrgV1alpha1ScheduleSpecIoChaosSelector:
    r"""
    Selector is used to select pods that are used to inject chaos action.

    Attributes
    ----------
    annotationSelectors : {str:str}, default is Undefined, optional
        Map of string keys and values that can be used to select objects.
        A selector based on annotations.
    expressionSelectors : [ChaosMeshOrgV1alpha1ScheduleSpecIoChaosSelectorExpressionSelectorsItems0], default is Undefined, optional
        a slice of label selector expressions that can be used to select objects.
        A list of selectors based on set-based label expressions.
    fieldSelectors : {str:str}, default is Undefined, optional
        Map of string keys and values that can be used to select objects.
        A selector based on fields.
    labelSelectors : {str:str}, default is Undefined, optional
        Map of string keys and values that can be used to select objects.
        A selector based on labels.
    namespaces : [str], default is Undefined, optional
        Namespaces is a set of namespace to which objects belong.
    nodeSelectors : {str:str}, default is Undefined, optional
        Map of string keys and values that can be used to select nodes.
        Selector which must match a node's labels,
        and objects must belong to these selected nodes.
    nodes : [str], default is Undefined, optional
        Nodes is a set of node name and objects must belong to these nodes.
    podPhaseSelectors : [str], default is Undefined, optional
        PodPhaseSelectors is a set of condition of a pod at the current time.
        supported value: Pending / Running / Succeeded / Failed / Unknown
    pods : {str:[str]}, default is Undefined, optional
        Pods is a map of string keys and a set values that used to select pods.
        The key defines the namespace which pods belong,
        and the each values is a set of pod names.
    """


    annotationSelectors?: {str:str}

    expressionSelectors?: [ChaosMeshOrgV1alpha1ScheduleSpecIoChaosSelectorExpressionSelectorsItems0]

    fieldSelectors?: {str:str}

    labelSelectors?: {str:str}

    namespaces?: [str]

    nodeSelectors?: {str:str}

    nodes?: [str]

    podPhaseSelectors?: [str]

    pods?: {str:[str]}


schema ChaosMeshOrgV1alpha1ScheduleSpecIoChaosSelectorExpressionSelectorsItems0:
    r"""
    A label selector requirement is a selector that contains values, a key, and an operator that
    relates the key and values.

    Attributes
    ----------
    key : str, default is Undefined, required
        key is the label key that the selector applies to.
    operator : str, default is Undefined, required
        operator represents a key's relationship to a set of values.
        Valid operators are In, NotIn, Exists and DoesNotExist.
    values : [str], default is Undefined, optional
        values is an array of string values. If the operator is In or NotIn,
        the values array must be non-empty. If the operator is Exists or DoesNotExist,
        the values array must be empty. This array is replaced during a strategic
        merge patch.
    """


    key: str

    operator: str

    values?: [str]


schema ChaosMeshOrgV1alpha1ScheduleSpecJvmChaos:
    r"""
    JVMChaosSpec defines the desired state of JVMChaos

    Attributes
    ----------
    action : str, default is Undefined, required
        Action defines the specific jvm chaos action.
        Supported action: latency;return;exception;stress;gc;ruleData
    class : str, default is Undefined, optional
        Java class
    containerNames : [str], default is Undefined, optional
        ContainerNames indicates list of the name of affected container.
        If not set, the first container will be injected
    cpuCount : int, default is Undefined, optional
        the CPU core number needs to use, only set it when action is stress
    database : str, default is Undefined, optional
        the match database
        default value is "", means match all database
    duration : str, default is Undefined, optional
        Duration represents the duration of the chaos action
    exception : str, default is Undefined, optional
        the exception which needs to throw for action `exception`
        or the exception message needs to throw in action `mysql`
    latency : int, default is Undefined, optional
        the latency duration for action 'latency', unit ms
        or the latency duration in action `mysql`
    memType : str, default is Undefined, optional
        the memory type needs to locate, only set it when action is stress, the value can be 'stack' or 'heap'
    method : str, default is Undefined, optional
        the method in Java class
    mode : str, default is Undefined, required
        Mode defines the mode to run chaos action.
        Supported mode: one / all / fixed / fixed-percent / random-max-percent
    mysqlConnectorVersion : str, default is Undefined, optional
        the version of mysql-connector-java, only support 5.X.X(set to "5") and 8.X.X(set to "8") now
    name : str, default is Undefined, optional
        byteman rule name, should be unique, and will generate one if not set
    pid : int, default is Undefined, optional
        the pid of Java process which needs to attach
    port : int, default is Undefined, optional
        the port of agent server, default 9277
    remoteCluster : str, default is Undefined, optional
        RemoteCluster represents the remote cluster where the chaos will be deployed
    returnValue : str, default is Undefined, optional
        the return value for action 'return'
    ruleData : str, default is Undefined, optional
        the byteman rule's data for action 'ruleData'
    selector : ChaosMeshOrgV1alpha1ScheduleSpecJvmChaosSelector, default is Undefined, required
        selector
    sqlType : str, default is Undefined, optional
        the match sql type
        default value is "", means match all SQL type.
        The value can be 'select', 'insert', 'update', 'delete', 'replace'.
    table : str, default is Undefined, optional
        the match table
        default value is "", means match all table
    value : str, default is Undefined, optional
        Value is required when the mode is set to `FixedMode` / `FixedPercentMode` / `RandomMaxPercentMode`.
        If `FixedMode`, provide an integer of pods to do chaos action.
        If `FixedPercentMode`, provide a number from 0-100 to specify the percent of pods the server can do chaos action.
        IF `RandomMaxPercentMode`,  provide a number from 0-100 to specify the max percent of pods to do chaos action
    """


    action: "latency" | "return" | "exception" | "stress" | "gc" | "ruleData" | "mysql"

    class?: str

    containerNames?: [str]

    cpuCount?: int

    database?: str

    duration?: str

    exception?: str

    latency?: int

    memType?: str

    method?: str

    mode: "one" | "all" | "fixed" | "fixed-percent" | "random-max-percent"

    mysqlConnectorVersion?: str

    name?: str

    pid?: int

    port?: int

    remoteCluster?: str

    returnValue?: str

    ruleData?: str

    selector: ChaosMeshOrgV1alpha1ScheduleSpecJvmChaosSelector

    sqlType?: str

    table?: str

    value?: str


