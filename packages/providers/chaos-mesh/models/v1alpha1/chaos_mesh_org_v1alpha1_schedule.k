    TLS is the tls config,
    will override PodHttpChaos if there are multiple HTTPChaos experiments are applied

    Attributes
    ----------
    caName : str, default is Undefined, optional
        CAName represents the data name of ca file in secret, `ca.crt` for example
    certName : str, default is Undefined, required
        CertName represents the data name of cert file in secret, `tls.crt` for example
    keyName : str, default is Undefined, required
        KeyName represents the data name of key file in secret, `tls.key` for example
    secretName : str, default is Undefined, required
        SecretName represents the name of required secret resource
    secretNamespace : str, default is Undefined, required
        SecretNamespace represents the namespace of required secret resource
    """


    caName?: str

    certName: str

    keyName: str

    secretName: str

    secretNamespace: str


schema ChaosMeshOrgV1alpha1ScheduleSpecIoChaos:
    r"""
    IOChaosSpec defines the desired state of IOChaos

    Attributes
    ----------
    action : str, default is Undefined, required
        Action defines the specific pod chaos action.
        Supported action: latency / fault / attrOverride / mistake
    attr : ChaosMeshOrgV1alpha1ScheduleSpecIoChaosAttr, default is Undefined, optional
        attr
    containerNames : [str], default is Undefined, optional
        ContainerNames indicates list of the name of affected container.
        If not set, the first container will be injected
    delay : str, default is Undefined, optional
        Delay defines the value of I/O chaos action delay.
        A delay string is a possibly signed sequence of
        decimal numbers, each with optional fraction and a unit suffix,
        such as "300ms".
        Valid time units are "ns", "us" (or "µs"), "ms", "s", "m", "h".
    duration : str, default is Undefined, optional
        Duration represents the duration of the chaos action.
        It is required when the action is `PodFailureAction`.
        A duration string is a possibly signed sequence of
        decimal numbers, each with optional fraction and a unit suffix,
        such as "300ms", "-1.5h" or "2h45m".
        Valid time units are "ns", "us" (or "µs"), "ms", "s", "m", "h".
    errno : int, default is Undefined, optional
        Errno defines the error code that returned by I/O action.
        refer to: https://www-numi.fnal.gov/offline_software/srt_public_context/WebDocs/Errors/unix_system_errors.html
    methods : [str], default is Undefined, optional
        Methods defines the I/O methods for injecting I/O chaos action.
        default: all I/O methods.
    mistake : ChaosMeshOrgV1alpha1ScheduleSpecIoChaosMistake, default is Undefined, optional
        mistake
    mode : str, default is Undefined, required
        Mode defines the mode to run chaos action.
        Supported mode: one / all / fixed / fixed-percent / random-max-percent
    path : str, default is Undefined, optional
        Path defines the path of files for injecting I/O chaos action.
    percent : int, default is 100, optional
        Percent defines the percentage of injection errors and provides a number from 0-100.
        default: 100.
    remoteCluster : str, default is Undefined, optional
        RemoteCluster represents the remote cluster where the chaos will be deployed
    selector : ChaosMeshOrgV1alpha1ScheduleSpecIoChaosSelector, default is Undefined, required
        selector
    value : str, default is Undefined, optional
        Value is required when the mode is set to `FixedMode` / `FixedPercentMode` / `RandomMaxPercentMode`.
        If `FixedMode`, provide an integer of pods to do chaos action.
        If `FixedPercentMode`, provide a number from 0-100 to specify the percent of pods the server can do chaos action.
        IF `RandomMaxPercentMode`,  provide a number from 0-100 to specify the max percent of pods to do chaos action
    volumePath : str, default is Undefined, required
        VolumePath represents the mount path of injected volume
    """


    action: "latency" | "fault" | "attrOverride" | "mistake"

    attr?: ChaosMeshOrgV1alpha1ScheduleSpecIoChaosAttr

    containerNames?: [str]

    delay?: str

    duration?: str

    errno?: int

    methods?: [str]

    mistake?: ChaosMeshOrgV1alpha1ScheduleSpecIoChaosMistake

    mode: "one" | "all" | "fixed" | "fixed-percent" | "random-max-percent"

    path?: str

    percent?: int = 100

    remoteCluster?: str

    selector: ChaosMeshOrgV1alpha1ScheduleSpecIoChaosSelector

    value?: str

    volumePath: str


