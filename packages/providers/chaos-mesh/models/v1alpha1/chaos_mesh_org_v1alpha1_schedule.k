schema ChaosMeshOrgV1alpha1ScheduleSpecWorkflowTemplatesItems0ScheduleStressChaosStressorsCPU:
    r"""
    CPUStressor stresses CPU out

    Attributes
    ----------
    load : int, default is Undefined, optional
        Load specifies P percent loading per CPU worker. 0 is effectively a sleep (no load) and 100
        is full loading.
    options : [str], default is Undefined, optional
        extend stress-ng options
    workers : int, default is Undefined, required
        Workers specifies N workers to apply the stressor.
        Maximum 8192 workers can run by stress-ng
    """


