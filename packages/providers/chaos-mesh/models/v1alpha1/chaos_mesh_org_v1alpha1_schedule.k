schema ChaosMeshOrgV1alpha1ScheduleSpecStressChaosStressorsCPU:
    r"""
    CPUStressor stresses CPU out

    Attributes
    ----------
    load : int, default is Undefined, optional
        Load specifies P percent loading per CPU worker. 0 is effectively a sleep (no load) and 100
        is full loading.
    options : [str], default is Undefined, optional
        extend stress-ng options
    workers : int, default is Undefined, required
        Workers specifies N workers to apply the stressor.
        Maximum 8192 workers can run by stress-ng
    """


    load?: int

    options?: [str]

    workers: int


    check:
        load <= 100 if load not in [None, Undefined]
        load >= 0 if load not in [None, Undefined]
        workers <= 8192


schema ChaosMeshOrgV1alpha1ScheduleSpecStressChaosStressorsMemory:
    r"""
    MemoryStressor stresses virtual memory out

    Attributes
    ----------
    oomScoreAdj : int, default is Undefined, optional
        OOMScoreAdj sets the oom_score_adj of the stress process. See `man 5 proc` to know more
        about this option.
    options : [str], default is Undefined, optional
        extend stress-ng options
    size : str, default is Undefined, optional
        Size specifies N bytes consumed per vm worker, default is the total available memory.
        One can specify the size as % of total available memory or in units of B, KB/KiB,
        MB/MiB, GB/GiB, TB/TiB.
    workers : int, default is Undefined, required
        Workers specifies N workers to apply the stressor.
        Maximum 8192 workers can run by stress-ng
    """


    oomScoreAdj?: int = 0

    options?: [str]

    size?: str

    workers: int


    check:
        oomScoreAdj <= 1000 if oomScoreAdj not in [None, Undefined]
        oomScoreAdj >= -1000 if oomScoreAdj not in [None, Undefined]
        workers <= 8192


