schema ChaosMeshOrgV1alpha1ScheduleSpecPhysicalmachineChaosHTTPAbort:
    r"""
    chaos mesh org v1alpha1 schedule spec physicalmachine chaos HTTP abort

    Attributes
    ----------
    code : str, default is Undefined, optional
        Code is a rule to select target by http status code in response
