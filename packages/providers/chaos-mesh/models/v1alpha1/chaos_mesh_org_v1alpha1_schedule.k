    """


    containerNames?: [str]

    duration?: str

    failKernRequest: ChaosMeshOrgV1alpha1ScheduleSpecWorkflowTemplatesItems0KernelChaosFailKernRequest

    mode: "one" | "all" | "fixed" | "fixed-percent" | "random-max-percent"

