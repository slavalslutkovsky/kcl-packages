schema ChaosMeshOrgV1alpha1ScheduleSpecWorkflowTemplatesItems0AwsChaos:
    r"""
    AWSChaosSpec is the content of the specification for an AWSChaos

    Attributes
    ----------
    action : str, default is Undefined, required
        Action defines the specific aws chaos action.
        Supported action: ec2-stop / ec2-restart / detach-volume
        Default action: ec2-stop
    awsRegion : str, default is Undefined, required
        AWSRegion defines the region of aws.
    deviceName : str, default is Undefined, optional
        DeviceName indicates the name of the device.
        Needed in detach-volume.
    duration : str, default is Undefined, optional
        Duration represents the duration of the chaos action.
    ec2Instance : str, default is Undefined, required
        Ec2Instance indicates the ID of the ec2 instance.
    endpoint : str, default is Undefined, optional
        Endpoint indicates the endpoint of the aws server. Just used it in test now.
    remoteCluster : str, default is Undefined, optional
        RemoteCluster represents the remote cluster where the chaos will be deployed
    secretName : str, default is Undefined, optional
        SecretName defines the name of kubernetes secret.
    volumeID : str, default is Undefined, optional
        EbsVolume indicates the ID of the EBS volume.
        Needed in detach-volume.
    """


    action: "ec2-stop" | "ec2-restart" | "detach-volume"

    awsRegion: str

    deviceName?: str

    duration?: str

    ec2Instance: str

    endpoint?: str

    remoteCluster?: str

    secretName?: str

    volumeID?: str


schema ChaosMeshOrgV1alpha1ScheduleSpecWorkflowTemplatesItems0AzureChaos:
    r"""
    AzureChaosSpec is the content of the specification for an AzureChaos

    Attributes
    ----------
    action : str, default is Undefined, required
        Action defines the specific azure chaos action.
        Supported action: vm-stop / vm-restart / disk-detach
        Default action: vm-stop
    diskName : str, default is Undefined, optional
        DiskName indicates the name of the disk.
        Needed in disk-detach.
    duration : str, default is Undefined, optional
        Duration represents the duration of the chaos action.
    lun : int, default is Undefined, optional
        LUN indicates the Logical Unit Number of the data disk.
        Needed in disk-detach.
    remoteCluster : str, default is Undefined, optional
        RemoteCluster represents the remote cluster where the chaos will be deployed
    resourceGroupName : str, default is Undefined, required
