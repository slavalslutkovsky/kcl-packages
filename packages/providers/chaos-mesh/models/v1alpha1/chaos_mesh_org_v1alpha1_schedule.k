schema ChaosMeshOrgV1alpha1ScheduleSpecPhysicalmachineChaosNetworkCorrupt:
    r"""
    chaos mesh org v1alpha1 schedule spec physicalmachine chaos network corrupt

    Attributes
    ----------
    correlation : str, default is Undefined, optional
        correlation is percentage (10 is 10%)
    device : str, default is Undefined, optional
        the network interface to impact
    "egress-port" : str, default is Undefined, optional
        only impact egress traffic to these destination ports, use a ',' to separate or to indicate the range, such as 80, 8001:8010.
        it can only be used in conjunction with -p tcp or -p udp
    hostname : str, default is Undefined, optional
        only impact traffic to these hostnames
    "ip-address" : str, default is Undefined, optional
        only impact egress traffic to these IP addresses
    "ip-protocol" : str, default is Undefined, optional
        only impact traffic using this IP protocol, supported: tcp, udp, icmp, all
    percent : str, default is Undefined, optional
        percentage of packets to corrupt (10 is 10%)
    "source-port" : str, default is Undefined, optional
        only impact egress traffic from these source ports, use a ',' to separate or to indicate the range, such as 80, 8001:8010.
        it can only be used in conjunction with -p tcp or -p udp
    """


    correlation?: str

    device?: str

    "egress-port"?: str

    hostname?: str

    "ip-address"?: str

    "ip-protocol"?: str

    percent?: str

    "source-port"?: str


