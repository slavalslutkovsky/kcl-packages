    name?: str

    pid?: int

    port?: int

    remoteCluster?: str

    returnValue?: str

    ruleData?: str

    selector: ChaosMeshOrgV1alpha1WorkflowNodeSpecJvmChaosSelector

    sqlType?: str

    table?: str

    value?: str


