    notificationConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderNotificationConfig, default is Undefined, optional
        notification config
    podAutoscaling : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderPodAutoscaling, default is Undefined, optional
        pod autoscaling
    privateClusterConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderPrivateClusterConfig, default is Undefined, optional
