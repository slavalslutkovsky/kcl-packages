schema ContainerGcpmUpboundIoV1beta1ClusterSpecForProviderClusterAutoscalingAutoProvisioningDefaultsUpgradeSettings:
    r"""
    Specifies the upgrade settings for NAP created node pools. Structure is documented below.

    Attributes
    ----------
    blueGreenSettings : ContainerGcpmUpboundIoV1beta1ClusterSpecForProviderClusterAutoscalingAutoProvisioningDefaultsUpgradeSettingsBlueGreenSettings, default is Undefined, optional
        blue green settings
    maxSurge : float, default is Undefined, optional
        The maximum number of nodes that can be created beyond the current size of the node pool during the upgrade process. To be used when strategy is set to SURGE. Default is 0.
    maxUnavailable : float, default is Undefined, optional
        The maximum number of nodes that can be simultaneously unavailable during the upgrade process. To be used when strategy is set to SURGE. Default is 0.
    strategy : str, default is Undefined, optional
        Strategy used for node pool update. Strategy can only be one of BLUE_GREEN or SURGE. The default is value is SURGE.
    """


