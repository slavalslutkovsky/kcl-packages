schema ContainerGcpmUpboundIoV1beta1ClusterSpecInitProvider:
    r"""
    THIS IS A BETA FIELD. It will be honored
    unless the Management Policies feature flag is disabled.
    InitProvider holds the same fields as ForProvider, with the exception
    of Identifier and other resource reference fields. The fields that are
    in InitProvider are merged into ForProvider when the resource is created.
    The same fields are also added to the terraform ignore_changes hook, to
    avoid updating them after creation. This is useful for fields that are
    required on creation, but we do not desire to update them after creation,
    for example because of an external controller is managing them, like an
    autoscaler.

    Attributes
    ----------
    addonsConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderAddonsConfig, default is Undefined, optional
        addons config
    allowNetAdmin : bool, default is Undefined, optional
        Enable NET_ADMIN for the cluster. Defaults to
        false. This field should only be enabled for Autopilot clusters (enable_autopilot
        set to true).
    anonymousAuthenticationConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderAnonymousAuthenticationConfig, default is Undefined, optional
        anonymous authentication config
    authenticatorGroupsConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderAuthenticatorGroupsConfig, default is Undefined, optional
        authenticator groups config
    binaryAuthorization : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderBinaryAuthorization, default is Undefined, optional
        binary authorization
    clusterAutoscaling : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderClusterAutoscaling, default is Undefined, optional
        cluster autoscaling
    clusterIpv4Cidr : str, default is Undefined, optional
        The IP address range of the Kubernetes pods
        in this cluster in CIDR notation (e.g. 10.96.0.0/14). Leave blank to have one
        automatically chosen or specify a /14 block in 10.0.0.0/8. This field will
        default a new cluster to routes-based, where ip_allocation_policy is not defined.
    confidentialNodes : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderConfidentialNodes, default is Undefined, optional
        confidential nodes
    controlPlaneEndpointsConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderControlPlaneEndpointsConfig, default is Undefined, optional
        control plane endpoints config
    costManagementConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderCostManagementConfig, default is Undefined, optional
        cost management config
    databaseEncryption : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderDatabaseEncryption, default is Undefined, optional
        database encryption
    datapathProvider : str, default is Undefined, optional
        The desired datapath provider for this cluster. This is set to LEGACY_DATAPATH by default, which uses the IPTables-based kube-proxy implementation. Set to ADVANCED_DATAPATH to enable Dataplane v2.
    defaultMaxPodsPerNode : float, default is Undefined, optional
        The default maximum number of pods
        per node in this cluster. This doesn't work on "routes-based" clusters, clusters
        that don't have IP Aliasing enabled. See the official documentation
        for more information.
    defaultSnatStatus : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderDefaultSnatStatus, default is Undefined, optional
        default snat status
    deletionProtection : bool, default is Undefined, optional
        deletion protection
    description : str, default is Undefined, optional
        Description of the cluster.
    disableL4LbFirewallReconciliation : bool, default is Undefined, optional
        Disable L4 load balancer VPC firewalls to enable firewall policies.
    dnsConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderDNSConfig, default is Undefined, optional
        dns config
    enableAutopilot : bool, default is Undefined, optional
        Enable Autopilot for this cluster. Defaults to false.
        Note that when this option is enabled, certain features of Standard GKE are not available.
        See the official documentation
        for available features.
    enableCiliumClusterwideNetworkPolicy : bool, default is Undefined, optional
        Whether CiliumClusterWideNetworkPolicy is enabled on this cluster. Defaults to false.
    enableFqdnNetworkPolicy : bool, default is Undefined, optional
        Whether FQDN Network Policy is enabled on this cluster. Users who enable this feature for existing Standard clusters must restart the GKE Dataplane V2 anetd DaemonSet after enabling it. See the Enable FQDN Network Policy in an existing cluster for more information.
    enableIntranodeVisibility : bool, default is Undefined, optional
        Whether Intra-node visibility is enabled for this cluster. This makes same node pod to pod traffic visible for VPC network.
    enableK8SBetaApis : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderEnableK8SBetaApis, default is Undefined, optional
        enable k8 s beta apis
    enableKubernetesAlpha : bool, default is Undefined, optional
        Whether to enable Kubernetes Alpha features for
        this cluster. Note that when this option is enabled, the cluster cannot be upgraded
        and will be automatically deleted after 30 days.
    enableL4IlbSubsetting : bool, default is Undefined, optional
        Whether L4ILB Subsetting is enabled for this cluster.
    enableLegacyAbac : bool, default is Undefined, optional
        Whether the ABAC authorizer is enabled for this cluster.
        When enabled, identities in the system, including service accounts, nodes, and controllers,
        will have statically granted permissions beyond those provided by the RBAC configuration or IAM.
        Defaults to false
    enableMultiNetworking : bool, default is Undefined, optional
        Whether multi-networking is enabled for this cluster.
    enableShieldedNodes : bool, default is Undefined, optional
        Enable Shielded Nodes features on all nodes in this cluster.  Defaults to true.
    enableTpu : bool, default is Undefined, optional
        Whether to enable Cloud TPU resources in this cluster.
        See the official documentation.
    enterpriseConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderEnterpriseConfig, default is Undefined, optional
        enterprise config
    fleet : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderFleet, default is Undefined, optional
        fleet
    gatewayApiConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderGatewayAPIConfig, default is Undefined, optional
        gateway Api config
    gkeAutoUpgradeConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderGkeAutoUpgradeConfig, default is Undefined, optional
        gke auto upgrade config
    identityServiceConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderIdentityServiceConfig, default is Undefined, optional
        identity service config
    inTransitEncryptionConfig : str, default is Undefined, optional
        Defines the config of in-transit encryption. Valid values are IN_TRANSIT_ENCRYPTION_DISABLED and IN_TRANSIT_ENCRYPTION_INTER_NODE_TRANSPARENT.
    initialNodeCount : float, default is Undefined, optional
        The number of nodes to create in this
        cluster's default node pool. In regional or multi-zonal clusters, this is the
        number of nodes per zone. Must be set if node_pool is not set. If you're using
        google_container_node_pool objects with no default node pool, you'll need to
        set this to a value of at least 1, alongside setting
        remove_default_node_pool to true.
    ipAllocationPolicy : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderIPAllocationPolicy, default is Undefined, optional
        ip allocation policy
    loggingConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderLoggingConfig, default is Undefined, optional
        logging config
    loggingService : str, default is Undefined, optional
        The logging service that the cluster should
        write logs to. Available options include logging.googleapis.com(Legacy Stackdriver),
        logging.googleapis.com/kubernetes(Stackdriver Kubernetes Engine Logging), and none. Defaults to logging.googleapis.com/kubernetes
    maintenancePolicy : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderMaintenancePolicy, default is Undefined, optional
        maintenance policy
    masterAuth : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderMasterAuth, default is Undefined, optional
        master auth
    masterAuthorizedNetworksConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderMasterAuthorizedNetworksConfig, default is Undefined, optional
        master authorized networks config
    meshCertificates : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderMeshCertificates, default is Undefined, optional
        mesh certificates
    minMasterVersion : str, default is Undefined, optional
        The minimum version of the master. GKE
        will auto-update the master to new versions, so this does not guarantee the
        current master version--use the read-only master_version field to obtain that.
        If unset, the cluster's version will be set by GKE to the version of the most recent
        official release (which is not necessarily the latest version). If you intend to specify versions manually,
        the docs
        describe the various acceptable formats for this field.
    monitoringConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderMonitoringConfig, default is Undefined, optional
        monitoring config
    monitoringService : str, default is Undefined, optional
        The monitoring service that the cluster
        should write metrics to.
        Automatically send metrics from pods in the cluster to the Google Cloud Monitoring API.
        VM metrics will be collected by Google Compute Engine regardless of this setting
        Available options include
        monitoring.googleapis.com(Legacy Stackdriver), monitoring.googleapis.com/kubernetes(Stackdriver Kubernetes Engine Monitoring), and none.
        Defaults to monitoring.googleapis.com/kubernetes
    network : str, default is Undefined, optional
        The name or self_link of the Google Compute Engine
        network to which the cluster is connected. For Shared VPC, set this to the self link of the
        shared network.
    networkPerformanceConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderNetworkPerformanceConfig, default is Undefined, optional
        network performance config
    networkPolicy : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderNetworkPolicy, default is Undefined, optional
        network policy
    networkRef : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderNetworkRef, default is Undefined, optional
        network ref
    networkSelector : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderNetworkSelector, default is Undefined, optional
        network selector
    networkingMode : str, default is Undefined, optional
        Determines whether alias IPs or routes will be used for pod IPs in the cluster.
        Options are VPC_NATIVE or ROUTES. VPC_NATIVE enables IP aliasing. Newly created clusters will default to VPC_NATIVE.
    nodeConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderNodeConfig, default is Undefined, optional
        node config
    nodeLocations : [str], default is Undefined, optional
        The list of zones in which the cluster's nodes
        are located. Nodes must be in the region of their regional cluster or in the
        same region as their cluster's zone for zonal clusters. If this is specified for
        a zonal cluster, omit the cluster's zone.
    nodePoolAutoConfig : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderNodePoolAutoConfig, default is Undefined, optional
        node pool auto config
    nodePoolDefaults : ContainerGcpmUpboundIoV1beta1ClusterSpecInitProviderNodePoolDefaults, default is Undefined, optional
        node pool defaults
    nodeVersion : str, default is Undefined, optional
        The Kubernetes version on the nodes. Must either be unset
        or set to the same value as min_master_version on create. Defaults to the default
        version set by GKE which is not necessarily the latest version. This only affects
        nodes in the default node pool.
