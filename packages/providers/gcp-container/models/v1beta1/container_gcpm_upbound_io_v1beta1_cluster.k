schema ContainerGcpmUpboundIoV1beta1ClusterStatusAtProviderNodePoolItems0NodeConfigKubeletConfig:
    r"""
    Kubelet configuration, currently supported attributes can be found here.
    Structure is documented below.

    Attributes
    ----------
    allowedUnsafeSysctls : [str], default is Undefined, optional
        Defines a comma-separated allowlist of unsafe sysctls or sysctl patterns which can be set on the Pods. The allowed sysctl groups are kernel.shm*, kernel.msg*, kernel.sem, fs.mqueue.*, and net.*.
    containerLogMaxFiles : float, default is Undefined, optional
        Defines the maximum number of container log files that can be present for a container. The integer must be between 2 and 10, inclusive.
    containerLogMaxSize : str, default is Undefined, optional
        Defines the maximum size of the
        container log file before it is rotated. Specified as a positive number and a
        unit suffix, such as "100Ki", "10Mi". Valid units are "Ki", "Mi", "Gi".
        The value must be between "10Mi" and "500Mi", inclusive. And the total container log size
        (container_log_max_size * container_log_max_files) cannot exceed 1% of the total storage of the node.
    cpuCfsQuota : bool, default is Undefined, optional
        If true, enables CPU CFS quota enforcement for
        containers that specify CPU limits.
    cpuCfsQuotaPeriod : str, default is Undefined, optional
        The CPU CFS quota period value. Specified
        as a sequence of decimal numbers, each with optional fraction and a unit suffix,
        such as "300ms". Valid time units are "ns", "us" (or "µs"), "ms", "s", "m",
        "h". The value must be a positive duration.
    cpuManagerPolicy : str, default is Undefined, optional
        The CPU management policy on the node. See
        K8S CPU Management Policies.
        One of "none" or "static". If unset (or set to the empty string ""), the API will treat the field as if set to "none".
        Prior to the 6.4.0 this field was marked as required. The workaround for the required field
        is setting the empty string "", which will function identically to not setting this field.
    imageGcHighThresholdPercent : float, default is Undefined, optional
        Defines the percent of disk usage after which image garbage collection is always run. The integer must be between 10 and 85, inclusive.
    imageGcLowThresholdPercent : float, default is Undefined, optional
        Defines the percent of disk usage before which image garbage collection is never run. Lowest disk usage to garbage collect to. The integer must be between 10 and 85, inclusive.
    imageMaximumGcAge : str, default is Undefined, optional
        Defines the maximum age an image can be unused before it is garbage collected. Specified as a sequence of decimal numbers, each with optional fraction and a unit suffix, such as "300s", "1.5m", and "2h45m". Valid time units are "ns", "us" (or "µs"), "ms", "s", "m", "h". The value must be a positive duration.
    imageMinimumGcAge : str, default is Undefined, optional
        Defines the minimum age for an unused image before it is garbage collected. Specified as a sequence of decimal numbers, each with optional fraction and a unit suffix, such as "300s", "1.5m". The value cannot be greater than "2m".
    insecureKubeletReadonlyPortEnabled : str, default is Undefined, optional
        only port is enabled for newly created node pools in the cluster. It is strongly recommended to set this to FALSE. Possible values: TRUE, FALSE.
    memoryManager : ContainerGcpmUpboundIoV1beta1ClusterStatusAtProviderNodePoolItems0NodeConfigKubeletConfigMemoryManager, default is Undefined, optional
        memory manager
    podPidsLimit : float, default is Undefined, optional
        Controls the maximum number of processes allowed to run in a pod. The value must be greater than or equal to 1024 and less than 4194304.
    topologyManager : ContainerGcpmUpboundIoV1beta1ClusterStatusAtProviderNodePoolItems0NodeConfigKubeletConfigTopologyManager, default is Undefined, optional
        topology manager
    """


    allowedUnsafeSysctls?: [str]

    containerLogMaxFiles?: float

    containerLogMaxSize?: str

    cpuCfsQuota?: bool

    cpuCfsQuotaPeriod?: str

    cpuManagerPolicy?: str

    imageGcHighThresholdPercent?: float

    imageGcLowThresholdPercent?: float

    imageMaximumGcAge?: str

    imageMinimumGcAge?: str

    insecureKubeletReadonlyPortEnabled?: str

    memoryManager?: ContainerGcpmUpboundIoV1beta1ClusterStatusAtProviderNodePoolItems0NodeConfigKubeletConfigMemoryManager

    podPidsLimit?: float

    topologyManager?: ContainerGcpmUpboundIoV1beta1ClusterStatusAtProviderNodePoolItems0NodeConfigKubeletConfigTopologyManager


