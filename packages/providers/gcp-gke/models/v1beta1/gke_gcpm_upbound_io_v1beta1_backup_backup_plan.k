schema GkeGcpmUpboundIoV1beta1BackupBackupPlanSpecInitProviderRetentionPolicy:
    r"""
    RetentionPolicy governs lifecycle of Backups created under this plan.
    Structure is documented below.

    Attributes
    ----------
