schema ComputeGcpmUpboundIoV1beta1InstanceStatusAtProviderAttachedDiskItems0:
    r"""
    compute gcpm upbound io v1beta1 instance status at provider attached disk items0

    Attributes
    ----------
    deviceName : str, default is Undefined, optional
        Name with which the attached disk will be accessible
        under /dev/disk/by-id/google-*
