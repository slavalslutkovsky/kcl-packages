    binding?: KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesInterfacesItems0Binding

    bootOrder?: int

    bridge?: any

    dhcpOptions?: KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesInterfacesItems0DhcpOptions

    macAddress?: str

    macvtap?: any

    masquerade?: any

    model?: str

    name: str

    passt?: any

    pciAddress?: str

    ports?: [KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesInterfacesItems0PortsItems0]

    slirp?: any

    sriov?: any

    state?: str

    tag?: str


