schema KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevices:
    r"""
    Devices allows adding disks, network interfaces, and others

    Attributes
    ----------
    autoattachGraphicsDevice : bool, default is Undefined, optional
        Whether to attach the default graphics device or not.
        VNC will not be available if set to false. Defaults to true.
    autoattachInputDevice : bool, default is Undefined, optional
        Whether to attach an Input Device.
        Defaults to false.
    autoattachMemBalloon : bool, default is Undefined, optional
        Whether to attach the Memory balloon device with default period.
        Period can be adjusted in virt-config.
        Defaults to true.
    autoattachPodInterface : bool, default is Undefined, optional
        Whether to attach a pod network interface. Defaults to true.
    autoattachSerialConsole : bool, default is Undefined, optional
        Whether to attach the default virtio-serial console or not.
        Serial console access will not be available if set to false. Defaults to true.
    autoattachVSOCK : bool, default is Undefined, optional
        Whether to attach the VSOCK CID to the VM or not.
        VSOCK access will be available if set to true. Defaults to false.
    blockMultiQueue : bool, default is Undefined, optional
        Whether or not to enable virtio multi-queue for block devices.
        Defaults to false.
    clientPassthrough : any, default is Undefined, optional
        To configure and access client devices such as redirecting USB
    disableHotplug : bool, default is Undefined, optional
        DisableHotplug disabled the ability to hotplug disks.
    disks : [KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesDisksItems0], default is Undefined, optional
        Disks describes disks, cdroms and luns which are connected to the vmi.
    downwardMetrics : any, default is Undefined, optional
        DownwardMetrics creates a virtio serials for exposing the downward metrics to the vmi.
    filesystems : [KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesFilesystemsItems0], default is Undefined, optional
        Filesystems describes filesystem which is connected to the vmi.
    gpus : [KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesGpusItems0], default is Undefined, optional
        Whether to attach a GPU device to the vmi.
    hostDevices : [KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesHostDevicesItems0], default is Undefined, optional
        Whether to attach a host device to the vmi.
    inputs : [KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesInputsItems0], default is Undefined, optional
        Inputs describe input devices
    interfaces : [KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesInterfacesItems0], default is Undefined, optional
        Interfaces describe network interfaces which are added to the vmi.
    logSerialConsole : bool, default is Undefined, optional
        Whether to log the auto-attached default serial console or not.
        Serial console logs will be collect to a file and then streamed from a named 'guest-console-log'.
        Not relevant if autoattachSerialConsole is disabled.
        Defaults to cluster wide setting on VirtualMachineOptions.
    networkInterfaceMultiqueue : bool, default is Undefined, optional
        If specified, virtual network interfaces configured with a virtio bus will also enable the vhost multiqueue feature for network devices. The number of queues created depends on additional factors of the VirtualMachineInstance, like the number of guest CPUs.
    panicDevices : [KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesPanicDevicesItems0], default is Undefined, optional
        PanicDevices provides additional crash information when a guest crashes.
    rng : any, default is Undefined, optional
        Whether to have random number generator from host
    sound : KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesSound, default is Undefined, optional
        sound
    tpm : KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesTpm, default is Undefined, optional
        tpm
    useVirtioTransitional : bool, default is Undefined, optional
        Fall back to legacy virtio 0.9 support if virtio bus is selected on devices.
        This is helpful for old machines like CentOS6 or RHEL6 which
        do not understand virtio_non_transitional (virtio 1.0).
    video : KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesVideo, default is Undefined, optional
        video
    watchdog : KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesWatchdog, default is Undefined, optional
        watchdog
    """


    autoattachGraphicsDevice?: bool

    autoattachInputDevice?: bool

    autoattachMemBalloon?: bool

    autoattachPodInterface?: bool

    autoattachSerialConsole?: bool

    autoattachVSOCK?: bool

    blockMultiQueue?: bool

    clientPassthrough?: any

    disableHotplug?: bool

    disks?: [KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesDisksItems0]

    downwardMetrics?: any

    filesystems?: [KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesFilesystemsItems0]

    gpus?: [KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesGpusItems0]

    hostDevices?: [KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesHostDevicesItems0]

    inputs?: [KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesInputsItems0]

    interfaces?: [KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesInterfacesItems0]

    logSerialConsole?: bool

    networkInterfaceMultiqueue?: bool

    panicDevices?: [KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesPanicDevicesItems0]

    rng?: any

    sound?: KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesSound

    tpm?: KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesTpm

    useVirtioTransitional?: bool

    video?: KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesVideo

    watchdog?: KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesWatchdog


    check:
        len(disks) <= 256 if disks
        len(interfaces) <= 256 if interfaces


schema KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesDisksItems0:
    r"""
    kubevirt io v1 virtual machine spec template spec domain devices disks items0

    Attributes
    ----------
    blockSize : KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesDisksItems0BlockSize, default is Undefined, optional
        block size
    bootOrder : int, default is Undefined, optional
        BootOrder is an integer value > 0, used to determine ordering of boot devices.
        Lower values take precedence.
        Each disk or interface that has a boot order must have a unique value.
        Disks without a boot order are not tried if a disk with a boot order exists.
    cache : str, default is Undefined, optional
        Cache specifies which kvm disk cache mode should be used.
        Supported values are:
        none: Guest I/O not cached on the host, but may be kept in a disk cache.
        writethrough: Guest I/O cached on the host but written through to the physical medium. Slowest but with most guarantees.
        writeback: Guest I/O cached on the host.
        Defaults to none if the storage supports O_DIRECT, otherwise writethrough.
    cdrom : KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesDisksItems0Cdrom, default is Undefined, optional
        cdrom
    dedicatedIOThread : bool, default is Undefined, optional
        dedicatedIOThread indicates this disk should have an exclusive IO Thread.
        Enabling this implies useIOThreads = true.
        Defaults to false.
    disk : KubevirtIoV1VirtualMachineSpecTemplateSpecDomainDevicesDisksItems0Disk, default is Undefined, optional
        disk
    errorPolicy : str, default is Undefined, optional
        If specified, it can change the default error policy (stop) for the disk
    io : str, default is Undefined, optional
