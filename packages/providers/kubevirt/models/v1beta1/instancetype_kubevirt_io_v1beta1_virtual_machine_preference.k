    IPI improves performances in overcommited environments. Requires vpindex.
    Defaults to the machine type setting.

    Attributes
    ----------
    enabled : bool, default is Undefined, optional
        Enabled determines if the feature should be enabled or disabled on the guest.
        Defaults to true.
    """


    enabled?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredHypervReenlightenment:
    r"""
    Reenlightenment enables the notifications on TSC frequency changes.
    Defaults to the machine type setting.

    Attributes
    ----------
    enabled : bool, default is Undefined, optional
        Enabled determines if the feature should be enabled or disabled on the guest.
        Defaults to true.
    """


    enabled?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredHypervRelaxed:
    r"""
    Relaxed instructs the guest OS to disable watchdog timeouts.
    Defaults to the machine type setting.

    Attributes
    ----------
    enabled : bool, default is Undefined, optional
        Enabled determines if the feature should be enabled or disabled on the guest.
        Defaults to true.
    """


    enabled?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredHypervReset:
    r"""
    Reset enables Hyperv reboot/reset for the vmi. Requires synic.
    Defaults to the machine type setting.

    Attributes
    ----------
    enabled : bool, default is Undefined, optional
        Enabled determines if the feature should be enabled or disabled on the guest.
        Defaults to true.
    """


    enabled?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredHypervRuntime:
    r"""
    Runtime improves the time accounting to improve scheduling in the guest.
    Defaults to the machine type setting.

    Attributes
    ----------
    enabled : bool, default is Undefined, optional
        Enabled determines if the feature should be enabled or disabled on the guest.
        Defaults to true.
    """


    enabled?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredHypervSpinlocks:
    r"""
    Spinlocks allows to configure the spinlock retry attempts.

    Attributes
    ----------
    enabled : bool, default is Undefined, optional
        Enabled determines if the feature should be enabled or disabled on the guest.
        Defaults to true.
    spinlocks : int, default is Undefined, optional
        Retries indicates the number of retries.
        Must be a value greater or equal 4096.
        Defaults to 4096.
    """


    enabled?: bool

    spinlocks?: int


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredHypervSynic:
    r"""
    SyNIC enables the Synthetic Interrupt Controller.
    Defaults to the machine type setting.

    Attributes
    ----------
    enabled : bool, default is Undefined, optional
        Enabled determines if the feature should be enabled or disabled on the guest.
        Defaults to true.
    """


    enabled?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredHypervSynictimer:
    r"""
    SyNICTimer enables Synthetic Interrupt Controller Timers, reducing CPU load.
    Defaults to the machine type setting.

    Attributes
    ----------
    direct : InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredHypervSynictimerDirect, default is Undefined, optional
        direct
    enabled : bool, default is Undefined, optional
        enabled
    """


    direct?: InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredHypervSynictimerDirect

    enabled?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredHypervSynictimerDirect:
    r"""
    Represents if a feature is enabled or disabled.

    Attributes
    ----------
    enabled : bool, default is Undefined, optional
        Enabled determines if the feature should be enabled or disabled on the guest.
        Defaults to true.
    """


    enabled?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredHypervTlbflush:
    r"""
    TLBFlush improves performances in overcommited environments. Requires vpindex.
    Defaults to the machine type setting.

    Attributes
    ----------
    enabled : bool, default is Undefined, optional
        Enabled determines if the feature should be enabled or disabled on the guest.
        Defaults to true.
    """


    enabled?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredHypervVapic:
    r"""
    VAPIC improves the paravirtualized handling of interrupts.
    Defaults to the machine type setting.

    Attributes
    ----------
    enabled : bool, default is Undefined, optional
        Enabled determines if the feature should be enabled or disabled on the guest.
        Defaults to true.
    """


    enabled?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredHypervVendorid:
    r"""
    VendorID allows setting the hypervisor vendor id.
    Defaults to the machine type setting.

    Attributes
    ----------
    enabled : bool, default is Undefined, optional
        Enabled determines if the feature should be enabled or disabled on the guest.
        Defaults to true.
    vendorid : str, default is Undefined, optional
        VendorID sets the hypervisor vendor id, visible to the vmi.
        String up to twelve characters.
    """


    enabled?: bool

    vendorid?: str


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredHypervVpindex:
    r"""
    VPIndex enables the Virtual Processor Index to help windows identifying virtual processors.
    Defaults to the machine type setting.

    Attributes
    ----------
    enabled : bool, default is Undefined, optional
        Enabled determines if the feature should be enabled or disabled on the guest.
        Defaults to true.
    """


    enabled?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredKvm:
    r"""
    PreferredKvm optionally enables and configures KVM features

    Attributes
    ----------
    hidden : bool, default is Undefined, optional
        Hide the KVM hypervisor from standard MSR based discovery.
        Defaults to false
    """


    hidden?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredPvspinlock:
    r"""
    PreferredPvspinlock optionally enables the Pvspinlock feature

    Attributes
    ----------
    enabled : bool, default is Undefined, optional
        Enabled determines if the feature should be enabled or disabled on the guest.
        Defaults to true.
    """


    enabled?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFeaturesPreferredSmm:
    r"""
    PreferredSmm optionally enables the SMM feature

    Attributes
    ----------
    enabled : bool, default is Undefined, optional
        Enabled determines if the feature should be enabled or disabled on the guest.
        Defaults to true.
    """


    enabled?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFirmware:
    r"""
    Firmware optionally defines preferences associated with the Firmware attribute of a VirtualMachineInstance DomainSpec

    Attributes
    ----------
    preferredEfi : InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFirmwarePreferredEfi, default is Undefined, optional
        preferred efi
    preferredUseBios : bool, default is Undefined, optional
        PreferredUseBios optionally enables BIOS
    preferredUseBiosSerial : bool, default is Undefined, optional
        PreferredUseBiosSerial optionally transmitts BIOS output over the serial.

        Requires PreferredUseBios to be enabled.
    preferredUseEfi : bool, default is Undefined, optional
        PreferredUseEfi optionally enables EFI

        Deprecated: Will be removed with v1beta2 or v1
    preferredUseSecureBoot : bool, default is Undefined, optional
        PreferredUseSecureBoot optionally enables SecureBoot and the OVMF roms will be swapped for SecureBoot-enabled ones.

        Requires PreferredUseEfi and PreferredSmm to be enabled.

        Deprecated: Will be removed with v1beta2 or v1
    """


    preferredEfi?: InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFirmwarePreferredEfi

    preferredUseBios?: bool

    preferredUseBiosSerial?: bool

    preferredUseEfi?: bool

    preferredUseSecureBoot?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecFirmwarePreferredEfi:
    r"""
    PreferredEfi optionally enables EFI

    Attributes
    ----------
    persistent : bool, default is Undefined, optional
        If set to true, Persistent will persist the EFI NVRAM across reboots.
        Defaults to false
    secureBoot : bool, default is Undefined, optional
        If set, SecureBoot will be enabled and the OVMF roms will be swapped for
        SecureBoot-enabled ones.
        Requires SMM to be enabled.
        Defaults to true
    """


    persistent?: bool

    secureBoot?: bool


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecMachine:
    r"""
    Machine optionally defines preferences associated with the Machine attribute of a VirtualMachineInstance DomainSpec

    Attributes
    ----------
    preferredMachineType : str, default is Undefined, optional
        PreferredMachineType optionally defines the preferred machine type to use.
    """


    preferredMachineType?: str


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecRequirements:
    r"""
    Requirements defines the minium amount of instance type defined resources required by a set of preferences

    Attributes
    ----------
    cpu : InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecRequirementsCPU, default is Undefined, optional
        cpu
    memory : InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecRequirementsMemory, default is Undefined, optional
        memory
    """


    cpu?: InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecRequirementsCPU

    memory?: InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecRequirementsMemory


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecRequirementsCPU:
    r"""
    Required CPU related attributes of the instancetype.

    Attributes
    ----------
    guest : int, default is Undefined, required
        Minimal number of vCPUs required by the preference.
    """


    guest: int


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecRequirementsMemory:
    r"""
    Required Memory related attributes of the instancetype.

    Attributes
    ----------
    guest : int | str, default is Undefined, required
        Minimal amount of memory required by the preference.
    """


    guest: int | str


    check:
        _regex_match(str(guest), r"^(\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))))?$")


schema InstancetypeKubevirtIoV1beta1VirtualMachinePreferenceSpecVolumes:
    r"""
    Volumes optionally defines preferences associated with the Volumes attribute of a VirtualMachineInstace DomainSpec

    Attributes
    ----------
    preferredStorageClassName : str, default is Undefined, optional
        PreffereedStorageClassName optionally defines the preferred storageClass
    """


    preferredStorageClassName?: str


