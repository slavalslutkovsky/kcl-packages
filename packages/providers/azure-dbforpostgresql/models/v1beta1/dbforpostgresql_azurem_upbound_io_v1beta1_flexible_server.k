    autoGrowEnabled?: bool

    backupRetentionDays?: float

    createMode?: str

    customerManagedKey?: DbforpostgresqlAzuremUpboundIoV1beta1FlexibleServerSpecInitProviderCustomerManagedKey

    delegatedSubnetId?: str

    delegatedSubnetIdRef?: DbforpostgresqlAzuremUpboundIoV1beta1FlexibleServerSpecInitProviderDelegatedSubnetIDRef

    delegatedSubnetIdSelector?: DbforpostgresqlAzuremUpboundIoV1beta1FlexibleServerSpecInitProviderDelegatedSubnetIDSelector

    geoRedundantBackupEnabled?: bool

    highAvailability?: DbforpostgresqlAzuremUpboundIoV1beta1FlexibleServerSpecInitProviderHighAvailability

    identity?: DbforpostgresqlAzuremUpboundIoV1beta1FlexibleServerSpecInitProviderIdentity

    location?: str

    maintenanceWindow?: DbforpostgresqlAzuremUpboundIoV1beta1FlexibleServerSpecInitProviderMaintenanceWindow

    pointInTimeRestoreTimeInUtc?: str

    privateDnsZoneId?: str

    privateDnsZoneIdRef?: DbforpostgresqlAzuremUpboundIoV1beta1FlexibleServerSpecInitProviderPrivateDNSZoneIDRef

    privateDnsZoneIdSelector?: DbforpostgresqlAzuremUpboundIoV1beta1FlexibleServerSpecInitProviderPrivateDNSZoneIDSelector

    publicNetworkAccessEnabled?: bool

