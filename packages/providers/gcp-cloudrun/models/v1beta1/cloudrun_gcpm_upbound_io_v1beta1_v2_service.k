        The allocation type for this traffic target.
        Possible values are: TRAFFIC_TARGET_ALLOCATION_TYPE_LATEST, TRAFFIC_TARGET_ALLOCATION_TYPE_REVISION.
    """


    percent?: float

    revision?: str

    tag?: str

    $type?: str


