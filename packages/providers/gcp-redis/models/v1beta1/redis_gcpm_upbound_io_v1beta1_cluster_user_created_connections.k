        CONNECTION_TYPE_DISCOVERY
        CONNECTION_TYPE_PRIMARY
        CONNECTION_TYPE_READER
    forwardingRule : str, default is Undefined, optional
        The URI of the consumer side forwarding rule.
        Format:
