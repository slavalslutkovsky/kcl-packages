schema CdnAzuremUpboundIoV1beta1EndpointStatusAtProvider:
    r"""
    cdn azurem upbound io v1beta1 endpoint status at provider

    Attributes
    ----------
    contentTypesToCompress : [str], default is Undefined, optional
        An array of strings that indicates a content types on which compression will be applied. The value for the elements should be MIME types.
    deliveryRule : [CdnAzuremUpboundIoV1beta1EndpointStatusAtProviderDeliveryRuleItems0], default is Undefined, optional
        Rules for the rules engine. An endpoint can contain up until 4 of those rules that consist of conditions and actions. A delivery_rule blocks as defined below.
    fqdn : str, default is Undefined, optional
        The Fully Qualified Domain Name of the CDN Endpoint.
    geoFilter : [CdnAzuremUpboundIoV1beta1EndpointStatusAtProviderGeoFilterItems0], default is Undefined, optional
        A set of Geo Filters for this CDN Endpoint. Each geo_filter block supports fields documented below.
    globalDeliveryRule : CdnAzuremUpboundIoV1beta1EndpointStatusAtProviderGlobalDeliveryRule, default is Undefined, optional
        global delivery rule
    id : str, default is Undefined, optional
        The ID of the CDN Endpoint.
    isCompressionEnabled : bool, default is Undefined, optional
        Indicates whether compression is to be enabled.
    isHttpAllowed : bool, default is Undefined, optional
        Specifies if http allowed. Defaults to true.
    isHttpsAllowed : bool, default is Undefined, optional
        Specifies if https allowed. Defaults to true.
    location : str, default is Undefined, optional
        Specifies the supported Azure location where the resource exists. Changing this forces a new resource to be created.
    optimizationType : str, default is Undefined, optional
        What types of optimization should this CDN Endpoint optimize for? Possible values include DynamicSiteAcceleration, GeneralMediaStreaming, GeneralWebDelivery, LargeFileDownload and VideoOnDemandMediaStreaming.
    origin : [CdnAzuremUpboundIoV1beta1EndpointStatusAtProviderOriginItems0], default is Undefined, optional
        The set of origins of the CDN endpoint. When multiple origins exist, the first origin will be used as primary and rest will be used as failover options. Each origin block supports fields documented below. Changing this forces a new resource to be created.
    originHostHeader : str, default is Undefined, optional
        The host header CDN provider will send along with content requests to origins.
    originPath : str, default is Undefined, optional
        The path used at for origin requests.
    probePath : str, default is Undefined, optional
        the path to a file hosted on the origin which helps accelerate delivery of the dynamic content and calculate the most optimal routes for the CDN. This is relative to the origin_path.
    profileName : str, default is Undefined, optional
        The CDN Profile to which to attach the CDN Endpoint. Changing this forces a new resource to be created.
    querystringCachingBehaviour : str, default is Undefined, optional
        Sets query string caching behavior. Allowed values are IgnoreQueryString, BypassCaching and UseQueryString. NotSet value can be used for Premium Verizon CDN profile. Defaults to IgnoreQueryString.
    resourceGroupName : str, default is Undefined, optional
        The name of the resource group in which to create the CDN Endpoint. Changing this forces a new resource to be created.
    tags : {str:str}, default is Undefined, optional
        A mapping of tags to assign to the resource.
    """


    contentTypesToCompress?: [str]

    deliveryRule?: [CdnAzuremUpboundIoV1beta1EndpointStatusAtProviderDeliveryRuleItems0]

    fqdn?: str

    geoFilter?: [CdnAzuremUpboundIoV1beta1EndpointStatusAtProviderGeoFilterItems0]

    globalDeliveryRule?: CdnAzuremUpboundIoV1beta1EndpointStatusAtProviderGlobalDeliveryRule

    id?: str

    isCompressionEnabled?: bool

    isHttpAllowed?: bool

    isHttpsAllowed?: bool

    location?: str

    optimizationType?: str

    origin?: [CdnAzuremUpboundIoV1beta1EndpointStatusAtProviderOriginItems0]

    originHostHeader?: str

    originPath?: str

    probePath?: str

    profileName?: str

    querystringCachingBehaviour?: str

    resourceGroupName?: str

    tags?: {str:str}


