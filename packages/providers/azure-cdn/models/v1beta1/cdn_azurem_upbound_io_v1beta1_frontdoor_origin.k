schema CdnAzuremUpboundIoV1beta1FrontdoorOriginStatusAtProvider:
    r"""
    cdn azurem upbound io v1beta1 frontdoor origin status at provider

    Attributes
    ----------
    cdnFrontdoorOriginGroupId : str, default is Undefined, optional
        The ID of the Front Door Origin Group within which this Front Door Origin should exist. Changing this forces a new Front Door Origin to be created.
    certificateNameCheckEnabled : bool, default is Undefined, optional
        Specifies whether certificate name checks are enabled for this origin.
    enabled : bool, default is Undefined, optional
        Should the origin be enabled? Possible values are true or false. Defaults to true.
    hostName : str, default is Undefined, optional
        The IPv4 address, IPv6 address or Domain name of the Origin.
    httpPort : float, default is Undefined, optional
        The value of the HTTP port. Must be between 1 and 65535. Defaults to 80.
    httpsPort : float, default is Undefined, optional
        The value of the HTTPS port. Must be between 1 and 65535. Defaults to 443.
    id : str, default is Undefined, optional
        The ID of the Front Door Origin.
    originHostHeader : str, default is Undefined, optional
        The host header value (an IPv4 address, IPv6 address or Domain name) which is sent to the origin with each request. If unspecified the hostname from the request will be used.
    priority : float, default is Undefined, optional
        Priority of origin in given origin group for load balancing. Higher priorities will not be used for load balancing if any lower priority origin is healthy. Must be between 1 and 5 (inclusive). Defaults to 1.
    privateLink : CdnAzuremUpboundIoV1beta1FrontdoorOriginStatusAtProviderPrivateLink, default is Undefined, optional
        private link
    weight : float, default is Undefined, optional
        The weight of the origin in a given origin group for load balancing. Must be between 1 and 1000. Defaults to 500.
    """


    cdnFrontdoorOriginGroupId?: str

    certificateNameCheckEnabled?: bool

    enabled?: bool

    hostName?: str

    httpPort?: float

    httpsPort?: float

    id?: str

    originHostHeader?: str

    priority?: float

    privateLink?: CdnAzuremUpboundIoV1beta1FrontdoorOriginStatusAtProviderPrivateLink

    weight?: float


