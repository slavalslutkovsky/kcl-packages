    accessLevelsRefs?: [AccesscontextmanagerGcpmUpboundIoV1beta1ServicePerimeterSpecInitProviderSpecAccessLevelsRefsItems0]

    accessLevelsSelector?: AccesscontextmanagerGcpmUpboundIoV1beta1ServicePerimeterSpecInitProviderSpecAccessLevelsSelector

