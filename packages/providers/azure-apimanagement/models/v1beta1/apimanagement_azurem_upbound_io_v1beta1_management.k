    A terms_of_service block as defined below.

    Attributes
    ----------
    consentRequired : bool, default is Undefined, optional
        Should the user be asked for consent during sign up?
    enabled : bool, default is Undefined, optional
        Should Terms of Service be displayed during sign up?.
    text : str, default is Undefined, optional
        The Terms of Service which users are required to agree to in order to sign up.
    """


    consentRequired?: bool

    enabled?: bool

    text?: str


schema ApimanagementAzuremUpboundIoV1beta1ManagementStatusAtProviderTenantAccess:
    r"""
    A tenant_access block as defined below.

    Attributes
    ----------
    enabled : bool, default is Undefined, optional
        Should the access to the management API be enabled?
    tenantId : str, default is Undefined, optional
        The identifier for the tenant access information contract.
    """


    enabled?: bool

    tenantId?: str


schema ApimanagementAzuremUpboundIoV1beta1ManagementStatusAtProviderVirtualNetworkConfiguration:
    r"""
    A virtual_network_configuration block as defined below. Required when virtual_network_type is External or Internal.

    Attributes
    ----------
    subnetId : str, default is Undefined, optional
        The id of the subnet that will be used for the API Management.
    """


    subnetId?: str


schema ApimanagementAzuremUpboundIoV1beta1ManagementStatusConditionsItems0:
    r"""
    A Condition that may apply to a resource.

    Attributes
    ----------
    lastTransitionTime : str, default is Undefined, required
        LastTransitionTime is the last time this condition transitioned from one
        status to another.
    message : str, default is Undefined, optional
        A Message containing details about this condition's last transition from
        one status to another, if any.
    observedGeneration : int, default is Undefined, optional
        ObservedGeneration represents the .metadata.generation that the condition was set based upon.
        For instance, if .metadata.generation is currently 12, but the .status.conditions[x].observedGeneration is 9, the condition is out of date
        with respect to the current state of the instance.
    reason : str, default is Undefined, required
        A Reason for this condition's last transition from one status to another.
    status : str, default is Undefined, required
        Status of this condition; is it currently True, False, or Unknown?
    $type : str, default is Undefined, required
        Type of this condition. At most one of each condition type may apply to
        a resource at any point in time.
    """


    lastTransitionTime: str

    message?: str

    observedGeneration?: int

    reason: str

    status: str

    $type: str


