{
 "format_version": "1.0",
 "terraform_version": "1.9.5",
 "values": {
  "root_module": {
   "resources": [
    {
     "address": "azurerm_storage_account.legacy",
     "mode": "managed",
     "type": "azurerm_storage_account",
     "name": "legacy",
     "provider_name": "registry.terraform.io/hashicorp/azurerm",
     "schema_version": 4,
     "values": {
      "name": "legacyst01",
      "resource_group_name": "rg-legacy",
      "location": "westeurope",
      "account_tier": "Standard",
      "account_replication_type": "LRS",
      "access_tier": "Cool",
      "tags": {
       "team": "platform"
      }
     }
    }
   ],
   "child_modules": [
    {
     "address": "module.media",
     "resources": [
      {
       "address": "module.media.google_storage_bucket.media",
       "mode": "managed",
       "type": "google_storage_bucket",
       "name": "media",
       "provider_name": "registry.terraform.io/hashicorp/google",
       "schema_version": 3,
       "values": {
        "name": "media-prod-4a2",
        "location": "US-CENTRAL1",
        "storage_class": "NEARLINE",
        "versioning": [
         {
          "enabled": true
         }
        ],
        "force_destroy": false,
        "uniform_bucket_level_access": true,
        "public_access_prevention": "enforced",
        "requester_pays": false,
        "labels": {
         "team": "media"
        },
        "encryption": [
         {
          "default_kms_key_name": "projects/p/locations/us/keyRings/r/cryptoKeys/k"
         }
        ],
        "retention_policy": [
         {
          "retention_period": 2592000,
          "is_locked": false
         }
        ],
        "logging": [
         {
          "log_bucket": "media-logs",
          "log_object_prefix": "media/"
         }
        ],
        "website": [
         {
          "main_page_suffix": "index.html",
          "not_found_page": "404.html"
         }
        ],
        "cors": [
         {
          "origin": [
           "https://example.com"
          ],
          "method": [
           "GET"
          ],
          "response_header": [
           "*"
          ],
          "max_age_seconds": 600
         }
        ],
        "lifecycle_rule": [
         {
          "action": [
           {
            "type": "SetStorageClass",
            "storage_class": "NEARLINE"
           }
          ],
          "condition": [
           {
            "age": 0,
            "send_age_if_zero": true,
            "matches_prefix": []
           }
          ]
         },
         {
          "action": [
           {
            "type": "Delete",
            "storage_class": ""
           }
          ],
          "condition": [
           {
            "age": 30,
            "matches_prefix": [
             "tmp/"
            ]
           }
          ]
         },
         {
          "action": [
           {
            "type": "SetStorageClass",
            "storage_class": "ARCHIVE"
           }
          ],
          "condition": [
           {
            "age": 365,
            "matches_prefix": []
           }
          ]
         },
         {
          "action": [
           {
            "type": "Delete",
            "storage_class": ""
           }
          ],
          "condition": [
           {
            "age": null,
            "num_newer_versions": 3,
            "matches_prefix": []
           }
          ]
         }
        ]
       }
      },
      {
       "address": "module.media.google_storage_bucket_iam_member.reader",
       "mode": "managed",
       "type": "google_storage_bucket_iam_member",
       "name": "reader",
       "values": {
        "bucket": "media-prod-4a2",
        "role": "roles/storage.objectViewer",
        "member": "allUsers"
       }
      }
     ]
    }
   ]
  }
 }
}