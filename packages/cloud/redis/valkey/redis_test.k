import .redis

_orphan = ["Observe", "Create", "Update", "LateInitialize"]

# ---- helpers ----------------------------------------------------------------
# NOTE: helper names must not collide with render()'s `oxr` parameter — KCL
# normalizes the leading underscore, so a helper named `_oxr` shadows it.
_build = lambda _spec, _ns: str = "default" {
    {apiVersion = "cloud.example.org/v1alpha1", kind = "RedisInstance", metadata = {name = "demo", namespace = _ns}, spec = _spec}
}

# The single Helm Release forProvider block from a render().
_fp = lambda _spec {
    redis.render(_build(_spec))[0].spec.forProvider
}

# The chart values the Release installs with.
_values = lambda _spec {
    _fp(_spec).values
}

# valkey.conf lines as a lookup, so tests assert on directives not on ordering.
_conf = lambda _spec {
    {_l.split(" ")[0]: _l.split(" ")[1] for _l in _values(_spec).commonConfiguration.split("\n")}
}

# ---- render: shape ----------------------------------------------------------
test_render_minimal = lambda {
    items = redis.render(_build({region = "in-cluster"}))
    assert len(items) == 1, "the in-cluster backend must emit exactly one Release"
    assert items[0].apiVersion == "helm.m.crossplane.io/v1beta1", "must use the namespaced helm CRD"
    assert items[0].kind == "Release", "wrong kind"
    assert items[0].metadata.annotations["krm.kcl.dev/composition-resource-name"] == "managed", "must be the managed resource"
    assert items[0].spec.providerConfigRef.kind == "ClusterProviderConfig", "must bind the cluster-wide helm config"
    fp = items[0].spec.forProvider
    assert fp.chart.name == "valkey", "chart must be valkey"
    assert fp.chart.repository == redis.chart_repository, "chart repository must be the pinned one"
    assert fp.chart.version == redis.chart_version, "chart version must be pinned, never floating"
    assert fp.wait == True, "the release must be waited on so auto-ready reflects reality"
}

# The chart lands in the XR's own namespace, not a shared one.
test_namespace_follows_xr = lambda {
    assert _fp({region = "in-cluster"}).namespace == "default", "default namespace when the XR has none"
    items = redis.render(_build({region = "in-cluster"}, "team-a"))
    assert items[0].spec.forProvider.namespace == "team-a", "release must follow the XR's namespace"
}

# ---- render: topology -------------------------------------------------------
test_architecture = lambda {
    assert _values({region = "in-cluster"}).architecture == "standalone", "no replicas -> standalone"
    assert _values({region = "in-cluster"}).replica.replicaCount == 0, "no replicas -> zero replica count"
    _v = _values({region = "in-cluster", replicas = 2})
    assert _v.architecture == "replication", "replicas -> replication"
    assert _v.replica.replicaCount == 2, "replica count must be carried"
}

# Failover needs a peer, so HA must add one even at replicas=0.
test_high_availability_forces_a_replica = lambda {
    _v = _values({region = "in-cluster", highAvailability = True})
    assert _v.architecture == "replication", "HA must switch to replication"
    assert _v.replica.replicaCount == 1, "HA must add a replica"
}

# ---- render: sizing ---------------------------------------------------------

# maxmemory must sit below the container limit or the pod is OOM-killed instead
# of evicting; the chart gets the limit, valkey.conf gets 80% of it.
test_memory_sizing = lambda {
    _v = _values({region = "in-cluster", memoryGb = 2})
    assert _v.primary.resources.limits.memory == "2Gi", "memoryGb must become the container limit"
    assert _v.primary.resources.requests.memory == "2Gi", "a cache must reserve what it can use"
    assert _conf({region = "in-cluster", memoryGb = 2})["maxmemory"] == "1638mb", "maxmemory must be 80% of the limit, in MiB"
    assert _conf({region = "in-cluster"})["maxmemory"] == "819mb", "the 1 GiB default must not round to a fractional gb"
}

test_persistence = lambda {
    _v = _values({region = "in-cluster"})
    assert _v.primary.persistence.enabled == True, "persistence defaults on"
    assert _v.primary.persistence.size == "8Gi", "PVC size defaults to 8Gi"
    _sized = _values({region = "in-cluster", persistenceSizeGb = 20})
    assert _sized.primary.persistence.size == "20Gi", "persistenceSizeGb must size the PVC"
    assert _sized.replica.persistence.size == "20Gi", "replicas must be sized like the primary"
    assert _values({region = "in-cluster", persistence = False}).primary.persistence.enabled == False, "persistence=false must disable the PVC"
}

# ---- render: auth and TLS ---------------------------------------------------
test_auth_and_tls = lambda {
    _v = _values({region = "in-cluster"})
    assert _v.auth.enabled == True, "auth defaults on"
    assert _v.tls.enabled == True, "TLS defaults on"
    assert _v.tls.autoGenerated == True, "TLS must self-provision certs, there is no cloud CA in-cluster"
    _off = _values({region = "in-cluster", authEnabled = False, transitEncryption = False})
    assert _off.auth.enabled == False, "authEnabled=false must be carried"
    assert _off.tls.enabled == False, "transitEncryption=false must be carried"
    assert _off.tls.autoGenerated == False, "no certs to generate when TLS is off"
}

# ---- render: parameters -----------------------------------------------------

# User parameters must override the defaults of the same name — `|`/`**` on
# option-sourced dicts unions instead, which is a hard error.
test_parameters_override_defaults = lambda {
    _c = _conf({region = "in-cluster", parameters = {"maxmemory-policy" = "noeviction"}})
    assert _c["maxmemory-policy"] == "noeviction", "a user parameter must win over the default"
    assert _c["maxmemory"] == "819mb", "unrelated defaults must survive the override"
    _extra = _conf({region = "in-cluster", parameters = {"appendonly" = "no"}})
    assert _extra["appendonly"] == "no", "new parameters must be appended"
    assert _extra["maxmemory-policy"] == "allkeys-lru", "the default eviction policy must remain"
    assert redis.override({a = "1", b = "2"}, {b = "9", c = "3"}) == {a = "1", b = "9", c = "3"}, "override must be last-wins plus union"
}

# Ordering must be stable or every reconcile rewrites the release.
test_config_lines_sorted = lambda {
    _lines = _values({region = "in-cluster", parameters = {"appendonly" = "yes", "zz-last" = "1"}}).commonConfiguration.split("\n")
    assert _lines == sorted(_lines), "valkey.conf lines must be emitted in a stable order"
}

test_labels = lambda {
    assert _values({region = "in-cluster", tags = {team = "platform"}}).commonLabels == {team = "platform"}, "tags -> commonLabels"
    assert _values({region = "in-cluster"})?.commonLabels == Undefined, "no labels unless asked for"
}

# ---- render: deletion policy ------------------------------------------------
test_deletion_policy = lambda {
    _orphaned = redis.render(_build({region = "in-cluster", deletionPolicy = "Orphan"}))[0].spec.managementPolicies
    assert _orphaned == _orphan, "Orphan must set the non-delete policies"
    _deleted = redis.render(_build({region = "in-cluster"}))[0].spec.managementPolicies
    assert not (_deleted == _orphan), "Delete must not set the orphan policies"
}

# ---- status -----------------------------------------------------------------

# In-cluster endpoints are derived from the release name, so they are known
# before the chart is deployed — but readiness is not.
test_status_pre_creation = lambda {
    dxr = redis.status(_build({region = "in-cluster"}, "team-a"), {})
    assert dxr.apiVersion == "cloud.example.org/v1alpha1", "dxr apiVersion must echo the composite"
    assert dxr.kind == "RedisInstance", "dxr kind must echo the composite"
    assert dxr.status.ready == False, "an undeployed release must not be ready"
    assert dxr.status.provider == "valkey", "provider must be valkey"
    assert dxr.status.host == "demo-primary.team-a.svc.cluster.local", "host is the chart's primary service"
    assert dxr.status.endpoint == "demo-primary.team-a.svc.cluster.local:6379", "endpoint must be host:port"
    assert dxr.status.readEndpoint == dxr.status.endpoint, "standalone reads from the primary"
    assert dxr.status.url == "rediss://demo-primary.team-a.svc.cluster.local:6379", "TLS must select the rediss scheme"
    assert dxr.status.authSecret == "demo", "the chart names the password secret after the release"
    assert dxr.status.authSecretKey == "valkey-password", "auth secret key must be published"
}

test_status_deployed = lambda {
    ocds = {
        managed = {
            Resource = {
                status = {
                    atProvider = {state = "deployed", revision = 3, version = "6.2.2"}
                }
            }
        }
    }
    dxr = redis.status(_build({region = "in-cluster", replicas = 2}, "team-a"), ocds)
    assert dxr.status.ready == True, "a deployed release must be ready"
    assert dxr.status.readEndpoint == "demo-replicas.team-a.svc.cluster.local:6379", "replicas get their own read service"
    assert dxr.status.version == "6.2.2", "chart version must be surfaced"
    assert dxr.status.id == "team-a/demo@3", "id must identify the release revision"
}

# A failed or pending release must not report ready.
test_status_failed_release = lambda {
    ocds = {
        managed = {
            Resource = {
                status = {
                    atProvider = {state = "failed", revision = 1}
                }
            }
        }
    }
    assert redis.status(_build({region = "in-cluster"}), ocds).status.ready == False, "a failed release must not be ready"
}

test_status_plaintext = lambda {
    dxr = redis.status(_build({region = "in-cluster", transitEncryption = False, authEnabled = False}), {})
    assert dxr.status.url.startswith("redis://"), "plaintext transport must use the redis scheme"
    assert dxr.status?.authSecret == Undefined, "no auth secret when auth is off"
}
