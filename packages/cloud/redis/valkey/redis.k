# redis (valkey) — Crossplane Composition logic (function-kcl module).
# The in-cluster backend: no cloud account, no VPC. Typed against the helm
# schema package, it renders one namespaced provider-helm Release that installs
# the Bitnami Valkey chart into the XR's own namespace. Valkey is the Linux
# Foundation's BSD-licensed Redis fork and speaks the same wire protocol, so a
# client configured for the AWS or GCP backend works here unchanged.
import helm.models.v1beta1.helmm_crossplane_io_v1beta1_release as backend

# Crossplane management policy set for the Orphan deletion policy (everything but Delete).
_orphan_policies = ["Observe", "Create", "Update", "LateInitialize"]

# Pinned so a re-render never silently upgrades a running dataset.
chart_repository = "oci://registry-1.docker.io/bitnamicharts"
chart_name = "valkey"
chart_version = "6.2.2"

# Chart resource names, given `fullnameOverride = <xr name>`.
primary_service = lambda name: str -> str {
    "${name}-primary"
}
replica_service = lambda name: str -> str {
    "${name}-replicas"
}

# Redis config overrides arrive as a map; valkey.conf wants "key value" lines.
# Sorted so an unordered map can't churn the Release on every reconcile.
config_lines = lambda params: {str:str} -> str {
    "\n".join(["${_k} ${params[_k]}" for _k in sorted(params)])
}

# `**` / `|` on dicts sourced from option("params") is a *union*: overlapping
# keys are a hard error, not an override. Build the merge explicitly so a user
# parameter always wins over the default of the same name.
override = lambda base: {str:str}, over: {str:str} -> {str:str} {
    {_k: (over[_k] if _k in over else base[_k]) for _k in base} | {_k: over[_k] for _k in over if _k not in base}
}

render = lambda oxr {
    _spec = oxr.spec
    _name = oxr.metadata.name
    _ns = oxr.metadata?.namespace or "default"

    _replicas = _spec?.replicas or 0
    _ha = _spec?.highAvailability or False
    _memory = _spec?.memoryGb or 1

    _auth = _spec?.authEnabled
    if _auth == Undefined:
        _auth = True

    _tls = _spec?.transitEncryption
    if _tls == Undefined:
        _tls = True

    _persist = _spec?.persistence
    if _persist == Undefined:
        _persist = True

    # A replica set is what makes failover possible in-cluster; highAvailability
    # with no explicit replicas still needs one, mirroring the AWS mapping.
    _replica_count = _replicas
    if _ha and _replica_count < 1:
        _replica_count = 1

    # Cap the dataset below the container limit: valkey needs headroom for the
    # copy-on-write fork it uses to snapshot, and a container that exceeds its
    # memory limit is OOM-killed rather than evicting. 80% is the common
    # rule of thumb. Units are MiB because valkey.conf rejects fractional sizes.
    _maxmemory = int(_memory * 1024 * 0.8)
    _defaults = {"maxmemory" = "${_maxmemory}mb", "maxmemory-policy" = "allkeys-lru"}
    _config = override(_defaults, _spec?.parameters or {})

    _node = {
        persistence = {enabled = _persist, size = "${_spec?.persistenceSizeGb or 8}Gi"}
        resources = {limits = {memory = "${_memory}Gi"}, requests = {memory = "${_memory}Gi"}}
    }

    _values = {
        fullnameOverride = _name
        architecture = "replication" if _replica_count > 0 else "standalone"
        commonConfiguration = config_lines(_config)
        auth = {enabled = _auth}
        tls = {enabled = _tls, autoGenerated = _tls, authClients = False}
        primary = _node
        replica = _node | {replicaCount = _replica_count}
        if _spec?.tags:
            commonLabels = _spec.tags
    }

    [backend.Release {
        metadata.annotations = {"krm.kcl.dev/composition-resource-name" = "managed"}
        if (_spec?.deletionPolicy or "Delete") == "Orphan":
            spec.managementPolicies = _orphan_policies
        # The helm provider runs with in-cluster identity, so one cluster-wide
        # config serves XRs in every namespace.
        spec.providerConfigRef = {kind = "ClusterProviderConfig", name = "default"}
        spec.forProvider.namespace = _ns
        spec.forProvider.chart = {
            name = chart_name
            repository = chart_repository
            version = chart_version
        }
        spec.forProvider.values = _values
        spec.forProvider.wait = True
        spec.forProvider.waitTimeout = "10m"
    }]
}

# Build the desired composite carrying observed status back to the XR.
# In-cluster endpoints are deterministic from the release name, so they are
# reported as soon as the chart is deployed rather than read back from AWS/GCP.
status = lambda oxr, ocds {
    _spec = oxr.spec
    _name = oxr.metadata.name
    _ns = oxr.metadata?.namespace or "default"
    _at = (ocds["managed"]?.Resource?.status?.atProvider) if ("managed" in ocds) else Undefined

    _tls = _spec?.transitEncryption
    if _tls == Undefined:
        _tls = True

    _auth = _spec?.authEnabled
    if _auth == Undefined:
        _auth = True

    _replicas = _spec?.replicas or 0
    if (_spec?.highAvailability or False) and _replicas < 1:
        _replicas = 1

    _host = "${primary_service(_name)}.${_ns}.svc.cluster.local"
    _reader = "${replica_service(_name)}.${_ns}.svc.cluster.local" if _replicas > 0 else _host
    _scheme = "rediss" if _tls else "redis"

    {
        apiVersion = oxr?.apiVersion or "cloud.example.org/v1alpha1"
        kind = oxr?.kind or "RedisInstance"
        metadata.name = _name
        status = {
            provider = "valkey"
            ready = (_at?.state or "") == "deployed"
            host = _host
            port = 6379
            endpoint = "${_host}:6379"
            readEndpoint = "${_reader}:6379"
            url = "${_scheme}://${_host}:6379"
            "cloud-url" = "kubernetes://${_ns}/statefulset/${_name}-primary"
            # The chart generates the password into a Secret named after the release.
            if _auth:
                authSecret = _name
                authSecretKey = "valkey-password"
            if _at?.version:
                version = _at.version
            if _at?.revision:
                id = "${_ns}/${_name}@${_at.revision}"
        }
    }
}
